# Секреты — в репозиторий не попадают никогда.
# На машине они лежат в ~/.netrc, ~/.npmrc, ~/.env, ~/.ssh, ~/.kube/config
# и хранятся отдельно (менеджер паролей, приватный репозиторий).
.env
.netrc
.npmrc
*.pem
*.key
*.crt
id_rsa*
id_ed25519*
kubeconfig*

