# Список всего, что ставится через Homebrew.
#
# Установить всё:            brew bundle --file=~/Desktop/dotfiles/macos/Brewfile
# Проверить, чего не хватает: brew bundle check --file=~/Desktop/dotfiles/macos/Brewfile
# Пересобрать файл по факту:  brew bundle dump --force --file=~/Desktop/dotfiles/macos/Brewfile
#
# ────────────────────────────── Консольные утилиты ──────────────────────────────

# Официальный CLI для Amazon AWS
brew "awscli"
# C++-клиент для ClickHouse (тянется как зависимость cask clickhouse)
brew "clickhouse-cpp"
# Подхватывает переменные окружения из .envrc при входе в папку
brew "direnv"
# Конвертация и запись аудио/видео
brew "ffmpeg"
# CLI для GitLab — аналог gh, но для GitLab
brew "glab"
# Интерактивный монитор процессов (продвинутый top)
brew "htop"
# Запуск проектных команд из justfile — как make, только проще
brew "just"
# Консольный клиент MongoDB
brew "mongosh"
# traceroute и ping в одном окне, с живой статистикой
brew "mtr"
# Библиотека рендеринга PDF (pdftotext, pdfimages и т.д.)
brew "poppler"
# PostgreSQL 18. link: true — класть psql и прочее в PATH
brew "postgresql@18", link: true
# Переключение версий Python
brew "pyenv"
# Сборка версий Ruby (бэкенд для rbenv)
brew "ruby-build"
# Клиент протокола TELNET — удобно проверять, открыт ли порт
brew "telnet"
# Дерево каталогов в консоли
brew "tree"
# Быстрый менеджер пакетов и окружений Python (замена pip + venv)
brew "uv"
# Скачивание файлов по HTTP/FTP
brew "wget"
# Менеджер пакетов JavaScript
brew "yarn"
# Скачивание видео с YouTube и сотен других сайтов
brew "yt-dlp"

# Управление яркостью экрана из консоли — нужен для macos/defaults/06-display-energy.sh
brew "brightness"
# CLI для Mac App Store — нужен для секции `mas` ниже
brew "mas"

# ─────────────────────────────── Приложения (cask) ───────────────────────────────

# VPN с обходом блокировок
cask "amneziavpn"
# Десктопный ChatGPT
cask "chatgpt"
# Десктопный Claude
cask "claude"
# Колоночная СУБД ClickHouse
cask "clickhouse"
# Редактор кода с ИИ (форк VS Code)
cask "cursor"
# Универсальный GUI-клиент к базам данных
cask "dbeaver-community"
# Форк Lens — GUI для Kubernetes
cask "freelens"
# Браузер по умолчанию на этом Mac
cask "google-chrome"
# Lens — GUI для Kubernetes
cask "lens"
# Мок-сервер для REST API
cask "mockoon"
# Запись экрана и трансляции
cask "obs"
# База знаний на локальных Markdown-файлах
cask "obsidian"
# Docker-окружение и Linux-машины, легче Docker Desktop
cask "orbstack"
# Клиент OpenVPN
cask "openvpn-connect"
# Шрифт редактора: на него ссылается editor.fontFamily в vscode/settings.json
cask "font-fira-code"
# Клиент для работы с HTTP API
cask "postman"
# IDE для Python
cask "pycharm"
# Скриншоты с распознаванием текста и измерениями
cask "shottr"
# Редактор кода. Настройки и расширения — в vscode/
cask "visual-studio-code"
# Терминал-мультиплексор с вкладками
cask "cmux"
# Видеоконференции
cask "zoom"

