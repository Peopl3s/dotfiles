mas "v2RayTun", id: 6476628951

# ────────────────────────── Глобальные пакеты npm и uv ──────────────────────────

# CLI Google Gemini
npm "@google/gemini-cli"
# CLI мок-сервера Mockoon
npm "@mockoon/cli"
# Среда выполнения и пакетный менеджер Bun
npm "bun"
# Переключатель менеджеров пакетов Node (npm / yarn / pnpm)
npm "corepack"

# Утилита построения графа знаний по проекту
uv "graphifyy"

# ──────────────────── Ставится вручную, cask-а не существует ────────────────────
#
# Эти программы стоят на машине, но в Homebrew их нет — на новом Mac придётся
# скачать с сайта. Список здесь, чтобы при переезде ничего не забыть.
#
#   ActiveCollab            — таск-трекер, https://activecollab.com/apps
#   Active Collab Timer     — есть в App Store, см. секцию mas выше
#   DeepSeek Harness        — https://deepseek.com
#   Devin                   — https://devin.ai
#   Endpoint Security VPN   — корпоративный VPN Check Point, даёт работодатель
#   NetBird                 — https://netbird.io/downloads
#   Sota Connect            — корпоративный клиент, даёт работодатель
#   UniVPN                  — корпоративный VPN, даёт работодатель
#   Yandex.Telemost         — https://telemost.yandex.ru
#
# Системные приложения Apple (Safari, Почта, Календарь) ставятся вместе с macOS.


