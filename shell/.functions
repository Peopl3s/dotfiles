# Функции шелла. Подключается из ~/.zshrc.
# Функции, в отличие от алиасов, умеют работать с аргументами.

# Создать папку и сразу зайти в неё: mkcd my-project
mkcd () {
  mkdir -p "$1" && cd "$1" || return
}

# Распаковать архив любого формата: extract archive.tar.gz
extract () {
  if [ ! -f "$1" ]; then
    echo "Файл не найден: $1" >&2
    return 1
  fi
  case "$1" in
    *.tar.bz2) tar xjf "$1" ;;
    *.tar.gz)  tar xzf "$1" ;;
    *.tar.xz)  tar xJf "$1" ;;
    *.tar)     tar xf  "$1" ;;
    *.tbz2)    tar xjf "$1" ;;
    *.tgz)     tar xzf "$1" ;;
    *.bz2)     bunzip2 "$1" ;;
    *.gz)      gunzip  "$1" ;;
    *.zip)     unzip   "$1" ;;
    *.Z)       uncompress "$1" ;;
    *.7z)      7z x    "$1" ;;
    *)         echo "Не знаю, как распаковать: $1" >&2; return 1 ;;
  esac
}

# Что занимает порт: port 8000
port () {
  lsof -nP -iTCP:"$1" -sTCP:LISTEN
}

# Убить процесс, который держит порт: killport 8000
killport () {
  local pid
  pid="$(lsof -ti tcp:"$1")"
  if [ -z "$pid" ]; then
    echo "Порт $1 свободен"
    return 0
  fi
  echo "Убиваю процесс $pid на порту $1"
  kill -9 "$pid"
}

# Размер содержимого текущей папки, отсортированный по убыванию.
bigdirs () {
  du -sh ./* 2>/dev/null | sort -rh | head -"${1:-15}"
}

# Применить настройки macOS из этого репозитория.
macos-apply () {
  bash "$HOME/Desktop/dotfiles/macos/settings.sh"
}

# Показать текущие настройки macOS (чтобы сверить с тем, что в репозитории).
macos-snapshot () {
  bash "$HOME/Desktop/dotfiles/macos/snapshot.sh"
}
