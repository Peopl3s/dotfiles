// Горячие клавиши VS Code.
// Симлинк на этот файл ставит steps/03-editors.sh.
//
// Взято из https://github.com/sobolevn/dotfiles/tree/master/vscode
// (коммит a0d77db, 2026-10-23), комментарии добавлены.
//
// Как читать файл:
//   "command": "editor.fold"    — НАЗНАЧАЕТ действие на сочетание клавиш
//   "command": "-editor.fold"   — минус в начале СНИМАЕТ стандартную привязку
//   "when": "editorTextFocus"   — условие: когда привязка действует
//
// Пары «снял стандартную — назначил свою» идут рядом: так сочетание
// переезжает с одного действия на другое.
[
  // назад по истории переходов
  {
    "key": "alt+left",
    "command": "workbench.action.navigateBack"
  },
  // снимает стандартную привязку: назад по истории переходов
  {
    "key": "ctrl+-",
    "command": "-workbench.action.navigateBack"
  },
  // вперёд по истории переходов
  {
    "key": "alt+right",
    "command": "workbench.action.navigateForward"
  },
  // снимает стандартную привязку: вперёд по истории переходов
  {
    "key": "ctrl+shift+-",
    "command": "-workbench.action.navigateForward"
  },
  // открыть settings.json
  {
    "key": "cmd+,",
    "command": "workbench.action.openSettingsJson"
  },
  // снимает стандартную привязку: открыть настройки в графическом виде
  {
    "key": "cmd+,",
    "command": "-workbench.action.openSettings"
  },
  // снимает стандартную привязку: свернуть всё дерево
  {
    "key": "shift+cmd+up",
    "command": "-list.collapseAll",
    "when": "listFocus && !inputFocus"
  },
  // снимает стандартную привязку: добавить курсор строкой выше
  {
    "key": "alt+cmd+up",
    "command": "-editor.action.insertCursorAbove",
    "when": "editorTextFocus"
  },
  // снимает стандартную привязку: добавить курсор строкой ниже
  {
    "key": "alt+cmd+down",
    "command": "-editor.action.insertCursorBelow",
    "when": "editorTextFocus"
  },
  // добавить курсор строкой выше
  {
    "key": "shift+cmd+up",
    "command": "editor.action.insertCursorAbove"
  },
  // добавить курсор строкой ниже
  {
    "key": "shift+cmd+down",
    "command": "editor.action.insertCursorBelow"
  },
  // снимает стандартную привязку: выделить до конца слова справа
  {
    "key": "shift+alt+right",
    "command": "-cursorWordEndRightSelect",
    "when": "textInputFocus"
  },
  // курсор к началу слова слева
  {
    "key": "shift+cmd+left",
    "command": "cursorWordStartLeft",
    "when": "textInputFocus"
  },
  // снимает стандартную привязку: курсор к началу слова слева
  {
    "key": "alt+left",
    "command": "-cursorWordStartLeft",
    "when": "textInputFocus"
  },
  // курсор к концу слова справа
  {
    "key": "shift+alt+right",
    "command": "cursorWordEndRight",
    "when": "textInputFocus"
  },
  // снимает стандартную привязку: курсор к концу слова справа
  {
    "key": "alt+right",
    "command": "-cursorWordEndRight",
    "when": "textInputFocus"
  },
  // снимает стандартную привязку: выделить до начала слова слева
  {
    "key": "shift+alt+left",
    "command": "-cursorWordStartLeftSelect",
    "when": "textInputFocus"
  },
  // курсор к концу слова слева
  {
    "key": "shift+alt+left",
    "command": "cursorWordEndLeft"
  },
  // снимает стандартную привязку: найти выделенный текст
  {
    "key": "cmd+e",
    "command": "-actions.findWithSelection"
  },
  // показать всплывающую подсказку
  {
    "key": "cmd+e",
    "command": "editor.action.showHover",
    "when": "editorTextFocus"
  },
  // снимает стандартную привязку: выполнить ячейку и перейти к следующей
  {
    "key": "shift+enter",
    "command": "-jupyter.runcurrentcelladvance",
    "when": "editorTextFocus && jupyter.featureenabled && jupyter.hascodecells && !editorHasSelection"
  },
  // снимает стандартную привязку: выполнить выделенное в интерактивном окне Jupyter
  {
    "key": "shift+enter",
    "command": "-jupyter.execSelectionInteractive",
    "when": "editorTextFocus && jupyter.featureenabled && jupyter.ownsSelection && !findInputFocussed && !replaceInputFocussed && editorLangId == 'python'"
  },
  // снимает стандартную привязку: выполнить выделенное в терминале
  {
    "key": "shift+enter",
    "command": "-python.execSelectionInTerminal",
    "when": "editorTextFocus && !findInputFocussed && !python.datascience.ownsSelection && !replaceInputFocussed && editorLangId == 'python'"
  },
  // скопировать относительный путь файла
  {
    "key": "cmd+l",
    "command": "copyRelativeFilePath"
  },
  // снимает стандартную привязку: скопировать относительный путь файла
  {
    "key": "shift+alt+cmd+c",
    "command": "-copyRelativeFilePath",
    "when": "!editorFocus"
  },
  // снимает стандартную привязку: выделить строку целиком
  {
    "key": "cmd+l",
    "command": "-expandLineSelection",
    "when": "editorFocus"
  },
  // снимает стандартную привязку: выделить строку целиком
  {
    "key": "cmd+l",
    "command": "-expandLineSelection",
    "when": "textInputFocus"
  },
  // снимает стандартную привязку: курсор на строку вверх
  {
    "key": "ctrl+p",
    "command": "-cursorUp",
    "when": "textInputFocus"
  },
  // снимает стандартную привязку: курсор на строку вниз
  {
    "key": "ctrl+n",
    "command": "-cursorDown",
    "when": "textInputFocus"
  },
  // снимает стандартную привязку: поиск символа по всему проекту
  {
    "key": "shift+cmd+r",
    "command": "-workbench.action.showAllSymbols"
  },
  // следующая вкладка окна
  {
    "key": "cmd+]",
    "command": "workbench.action.showNextWindowTab"
  },
  // предыдущая вкладка окна
  {
    "key": "cmd+[",
    "command": "workbench.action.showPreviousWindowTab"
  },
  // снимает стандартную привязку: сдвинуть строки влево
  {
    "key": "cmd+[",
    "command": "-editor.action.outdentLines",
    "when": "editorTextFocus && !editorReadonly"
  },
  // снимает стандартную привязку: сдвинуть строки вправо
  {
    "key": "cmd+]",
    "command": "-editor.action.indentLines",
    "when": "editorTextFocus && !editorReadonly"
  },
  // снимает стандартную привязку: разделить редактор поперёк
  {
    "key": "cmd+k cmd+\\",
    "command": "-workbench.action.splitEditorOrthogonal"
  },
  // снимает стандартную привязку: разделить редактор
  {
    "key": "alt+cmd+2",
    "command": "-workbench.action.splitEditor"
  },
  // снимает стандартную привязку: разделить редактор
  {
    "key": "cmd+k cmd+up",
    "command": "-workbench.action.splitEditor"
  },
  // снимает стандартную привязку: разделить редактор
  {
    "key": "cmd+\\",
    "command": "-workbench.action.splitEditor"
  },
  // снимает стандартную привязку: разделить терминал
  {
    "key": "cmd+\\",
    "command": "-workbench.action.terminal.split",
    "when": "terminalFocus && terminalProcessSupported"
  },
  // снимает стандартную привязку: разделить терминал
  {
    "key": "ctrl+shift+5",
    "command": "-workbench.action.terminal.split",
    "when": "terminalFocus && terminalProcessSupported"
  },
  // снимает стандартную привязку: выполнить выделенное в терминале
  {
    "key": "shift+enter",
    "command": "-python.execSelectionInTerminal",
    "when": "editorTextFocus && !findInputFocussed && !jupyter.ownsSelection && !notebookEditorFocused && !replaceInputFocussed && editorLangId == 'python'"
  },
  // снимает стандартную привязку: перейти к предыдущей проблеме
  {
    "key": "cmd+k p",
    "command": "-editor.action.marker.prev",
    "when": "editorFocus"
  },
  // снимает стандартную привязку: сортировать горячие клавиши по приоритету
  {
    "key": "alt+cmd+p",
    "command": "-keybindings.editor.toggleSortByPrecedence",
    "when": "inKeybindings"
  },
  // снимает стандартную привязку: сохранять регистр при замене
  {
    "key": "alt+cmd+p",
    "command": "-togglePreserveCase",
    "when": "editorFocus"
  },
  // снимает стандартную привязку: сохранять регистр при замене в поиске
  {
    "key": "alt+cmd+p",
    "command": "-toggleSearchPreserveCase",
    "when": "searchViewletFocus"
  },
  // снимает стандартную привязку: скопировать путь текущего файла
  {
    "key": "cmd+k p",
    "command": "-workbench.action.files.copyPathOfActiveFile"
  },
  // снимает стандартную привязку: следующий в списке файлов
  {
    "key": "cmd+p",
    "command": "-workbench.action.quickOpenNavigateNextInFilePicker",
    "when": "inFilesPicker && inQuickOpen"
  },
  // снимает стандартную привязку: предыдущий в списке файлов
  {
    "key": "shift+cmd+p",
    "command": "-workbench.action.quickOpenNavigatePreviousInFilePicker",
    "when": "inFilesPicker && inQuickOpen"
  },
  // снимает стандартную привязку: предыдущая вкладка
  {
    "key": "cmd+p",
    "command": "-workbench.action.quickOpenPreviousEditor"
  },
  // снимает стандартную привязку: вставить пустую строку снизу
  {
    "key": "cmd+enter",
    "command": "-editor.action.insertLineAfter",
    "when": "editorTextFocus && !editorReadonly"
  },
  // снимает стандартную привязку: вставить пустую строку сверху
  {
    "key": "shift+cmd+enter",
    "command": "-editor.action.insertLineBefore",
    "when": "editorTextFocus && !editorReadonly"
  },
  // снимает стандартную привязку: вставить ячейку ниже
  {
    "key": "cmd+enter",
    "command": "-notebook.cell.insertCodeCellBelow",
    "when": "notebookCellListFocused && !inputFocus"
  },
  // снимает стандартную привязку: открыть результаты поиска как файл
  {
    "key": "cmd+enter",
    "command": "-search.action.openInEditor",
    "when": "hasSearchResult && searchViewletFocus"
  },
  // снимает стандартную привязку: закоммитить (подтвердить ввод в панели git)
  {
    "key": "cmd+enter",
    "command": "-scm.acceptInput",
    "when": "scmRepository"
  },
  // снимает стандартную привязку: показать элемент из «хлебных крошек»
  {
    "key": "cmd+enter",
    "command": "-breadcrumbs.revealFocused",
    "when": "breadcrumbsActive && breadcrumbsVisible"
  },
  // снимает стандартную привязку: открыть элемент крошек в соседней панели
  {
    "key": "cmd+enter",
    "command": "-breadcrumbs.revealFocusedFromTreeAside",
    "when": "breadcrumbsActive && breadcrumbsVisible && listFocus && !inputFocus"
  },
  // снимает стандартную привязку: открыть точку останова в соседней панели
  {
    "key": "cmd+enter",
    "command": "-debug.openBreakpointToSide",
    "when": "breakpointsFocused"
  },
  // снимает стандартную привязку: отправить комментарий
  {
    "key": "cmd+enter",
    "command": "-workbench.action.submitComment",
    "when": "commentEditorFocused"
  },
  // снимает стандартную привязку: заменить все совпадения
  {
    "key": "cmd+enter",
    "command": "-editor.action.replaceAll",
    "when": "editorFocus && findWidgetVisible && replaceInputFocussed"
  },
  // снимает стандартную привязку: открыть файл
  {
    "key": "cmd+o",
    "command": "-workbench.action.files.openFile",
    "when": "false"
  },
  // снимает стандартную привязку: открыть файл или папку
  {
    "key": "cmd+o",
    "command": "-workbench.action.files.openFileFolder",
    "when": "isMacNative && openFolderWorkspaceSupport"
  },
  // снимает стандартную привязку: открыть локальный файл или папку
  {
    "key": "cmd+o",
    "command": "-workbench.action.files.openLocalFileFolder",
    "when": "remoteFileDialogVisible"
  },
  // снимает стандартную привязку: форматировать выделенное
  {
    "key": "cmd+k cmd+f",
    "command": "-editor.action.formatSelection",
    "when": "editorHasDocumentSelectionFormattingProvider && editorTextFocus && !editorReadonly"
  },
  // снимает стандартную привязку: поиск по списку
  {
    "key": "cmd+f",
    "command": "-list.find",
    "when": "listFocus && listSupportsFind"
  },
  // снимает стандартную привязку: закрыть терминал, открытый как вкладка
  {
    "key": "cmd+w",
    "command": "-workbench.action.terminal.killEditor",
    "when": "terminalEditorFocus && terminalFocus && terminalHasBeenCreated || terminalEditorFocus && terminalFocus && terminalProcessSupported"
  },
  // закрыть терминал
  {
    "key": "cmd+w",
    "command": "workbench.action.terminal.kill",
    "when": "terminalEditorFocus || terminalFocus"
  },
  // снимает стандартную привязку: выполнить в Python REPL
  {
    "key": "shift+enter",
    "command": "-python.execInREPL",
    "when": "config.python.REPL.sendToNativeREPL && editorTextFocus && !accessibilityModeEnabled && !jupyter.ownsSelection && !notebookEditorFocused && editorLangId == 'python' && activeEditor != 'workbench.editor.interactive'"
  },
  // снимает стандартную привязку: выполнить выделенное в терминале
  {
    "key": "shift+enter",
    "command": "-python.execSelectionInTerminal",
    "when": "editorTextFocus && !findInputFocussed && !jupyter.ownsSelection && !notebookEditorFocused && !replaceInputFocussed && editorLangId == 'python' && activeEditor != 'workbench.editor.interactive'"
  },
  // снимает стандартную привязку: выполнить ячейку и выделить следующую
  {
    "key": "shift+enter",
    "command": "-notebook.cell.executeAndSelectBelow",
    "when": "notebookCellListFocused && !inlineChatFocused && notebookCellType == 'markup' || notebookCellListFocused && notebookMissingKernelExtension && !inlineChatFocused && !notebookCellExecuting && notebookCellType == 'code' || notebookCellListFocused && !inlineChatFocused && !notebookCellExecuting && notebookCellType == 'code' && notebookKernelCount > 0 || notebookCellListFocused && !inlineChatFocused && !notebookCellExecuting && notebookCellType == 'code' && notebookKernelSourceCount > 0"
  },
  // снимает стандартную привязку: вставить ячейку выше
  {
    "key": "shift+cmd+enter",
    "command": "-notebook.cell.insertCodeCellAbove",
    "when": "notebookCellListFocused && !inputFocus"
  },
  // снимает стандартную привязку: следующее совпадение в терминале
  {
    "key": "shift+enter",
    "command": "-workbench.action.terminal.findNext",
    "when": "terminalFindInputFocused && terminalHasBeenCreated || terminalFindInputFocused && terminalProcessSupported"
  },
  // отменить поиск
  {
    "key": "cmd+f",
    "command": "search.action.cancel",
    "when": "listFocus && searchViewletVisible && !inputFocus && !treestickyScrollFocused && searchState != '0'"
  },
  // снимает стандартную привязку: отменить поиск
  {
    "key": "escape",
    "command": "-search.action.cancel",
    "when": "listFocus && searchViewletVisible && !inputFocus && !treestickyScrollFocused && searchState != '0'"
  },
  // снимает стандартную привязку: выполнить выделенное в терминале
  {
    "key": "shift+enter",
    "command": "-python.execSelectionInTerminal",
    "when": "editorTextFocus && !findInputFocussed && !isCompositeNotebook && !jupyter.ownsSelection && !notebookEditorFocused && !replaceInputFocussed && editorLangId == 'python'"
  },
  // снимает стандартную привязку: выполнить в Python REPL
  {
    "key": "shift+enter",
    "command": "-python.execInREPL",
    "when": "config.python.REPL.sendToNativeREPL && editorTextFocus && !isCompositeNotebook && !jupyter.ownsSelection && !notebookEditorFocused && editorLangId == 'python'"
  },
  // снимает стандартную привязку: подсказка для элемента списка
  {
    "key": "cmd+k cmd+i",
    "command": "-list.showHover",
    "when": "listFocus && !inputFocus && !treestickyScrollFocused"
  },
  // снимает стандартную привязку: подробности подсказки автодополнения
  {
    "key": "cmd+i",
    "command": "-toggleSuggestionDetails",
    "when": "suggestWidgetHasFocusedSuggestion && suggestWidgetVisible && textInputFocus"
  },
  // перейти к определению типа
  {
    "key": "shift+cmd+t",
    "command": "editor.action.goToTypeDefinition"
  },
  // вызвать автодополнение
  {
    "key": "ctrl+i",
    "command": "editor.action.triggerSuggest",
    "when": "editorHasCompletionItemProvider && textInputFocus && !editorReadonly && !suggestWidgetVisible"
  },
  // снимает стандартную привязку: вызвать автодополнение
  {
    "key": "cmd+i",
    "command": "-editor.action.triggerSuggest",
    "when": "editorHasCompletionItemProvider && textInputFocus && !editorReadonly && !suggestWidgetVisible"
  },
  // быстрый поиск по тексту проекта
  {
    "key": "ctrl+f",
    "command": "workbench.action.quickTextSearch"
  },
  // снимает стандартную привязку: курсор на символ вправо
  {
    "key": "ctrl+f",
    "command": "-cursorRight",
    "when": "textInputFocus"
  },
  // развернуть/свернуть нижнюю панель
  {
    "key": "shift+cmd+t",
    "command": "workbench.action.toggleMaximizedPanel"
  },
  // снимает стандартную привязку: панель системы контроля версий
  {
    "key": "ctrl+shift+g",
    "command": "-workbench.view.scm",
    "when": "workbench.scm.active"
  },
  // снимает стандартную привязку: голосовой ввод в чат
  {
    "key": "cmd+i",
    "command": "-workbench.action.chat.startVoiceChat",
    "when": "chatIsEnabled && hasSpeechProvider && inChatInput && !chatSessionRequestInProgress && !editorFocus && !notebookEditorFocused && !scopedVoiceChatGettingReady && !speechToTextInProgress || chatIsEnabled && hasSpeechProvider && inlineChatFocused && !chatSessionRequestInProgress && !editorFocus && !notebookEditorFocused && !scopedVoiceChatGettingReady && !speechToTextInProgress"
  },
  // снимает стандартную привязку: открыть чат
  {
    "key": "ctrl+cmd+i",
    "command": "-workbench.action.chat.open",
    "when": "!chatSetupHidden"
  },
  // снимает стандартную привязку: открыть чат в режиме агента
  {
    "key": "shift+cmd+i",
    "command": "-workbench.action.chat.openAgent",
    "when": "config.chat.agent.enabled && !chatSetupHidden"
  },
  // снимает стандартную привязку: остановить запись голоса и отправить
  {
    "key": "cmd+i",
    "command": "-workbench.action.chat.stopListeningAndSubmit",
    "when": "inChatInput && voiceChatInProgress && scopedVoiceChatInProgress == 'editor' || inChatInput && voiceChatInProgress && scopedVoiceChatInProgress == 'inline' || inChatInput && voiceChatInProgress && scopedVoiceChatInProgress == 'quick' || inChatInput && voiceChatInProgress && scopedVoiceChatInProgress == 'view' || inlineChatFocused && voiceChatInProgress && scopedVoiceChatInProgress == 'editor' || inlineChatFocused && voiceChatInProgress && scopedVoiceChatInProgress == 'inline' || inlineChatFocused && voiceChatInProgress && scopedVoiceChatInProgress == 'quick' || inlineChatFocused && voiceChatInProgress && scopedVoiceChatInProgress == 'view'"
  },
  // снимает стандартную привязку: закрыть встроенный чат
  {
    "key": "cmd+i",
    "command": "-inlineChat2.close",
    "when": "inlineChatHasEditsAgent && inlineChatVisible && !chatEdits.isRequestInProgress && chatEdits.requestCount == '0' || inlineChatHasEditsAgent && inlineChatVisible && !chatEdits.hasEditorModifications && !chatEdits.isRequestInProgress && chatEdits.requestCount == '0'"
  },
  // снимает стандартную привязку: открыть встроенный ИИ-чат
  {
    "key": "cmd+i",
    "command": "-inlineChat.start",
    "when": "editorFocus && inlineChatHasEditsAgent && inlineChatPossible && !editorReadonly && !editorSimpleInput || editorFocus && inlineChatHasProvider && inlineChatPossible && !editorReadonly && !editorSimpleInput"
  },
  // снимает стандартную привязку: встроенный ИИ-чат по текущей строке
  {
    "key": "cmd+k i",
    "command": "-inlineChat.startWithCurrentLine",
    "when": "inlineChatHasProvider && !editorReadonly && !inlineChatVisible"
  },
  // снимает стандартную привязку: встроенный ИИ-чат по текущей строке
  {
    "key": "cmd+i",
    "command": "-inlineChat.startWithCurrentLine",
    "when": "inlineChatHasProvider && inlineChatShowingHint && !editorReadonly && !inlineChatVisible"
  },
  // снимает стандартную привязку: ИИ-чат в терминале
  {
    "key": "cmd+i",
